{
  "redirects": [
    {
      "source": "/portfolio",
      "destination": "/portfolio/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/curso-ugc-ia",
      "destination": "/curso-ugc-ia/index.html"
    },
    {
      "source": "/wdf",
      "destination": "/index-v1.html"
    },
    {
      "source": "/wdf/(.*)",
      "destination": "/$1"
    },
    {
      "source": "/wdf2",
      "destination": "/wdf2.html"
    },
    {
      "source": "/bio",
      "destination": "/bio.html"
    },
    {
      "source": "/promo",
      "destination": "/index-v2.html"
    },
    {
      "source": "/",
      "destination": "/index-v2.html"
    }
  ],
  "headers": [
    {
      "source": "/ASSETS/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/v2/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.css",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.woff2",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/portfolio",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/portfolio/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/portfolio/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/portfolio/(index\\.html|proposta\\.js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/portfolio/(.*)\\.(mp4|webp|jpg)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000"
        }
      ]
    }
  ]
}
