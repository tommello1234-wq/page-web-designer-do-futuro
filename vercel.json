{
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.upwardacademy.com.br"
        }
      ],
      "destination": "https://upwardacademy.com.br/:path*",
      "permanent": true
    },
    {
      "source": "/:path((?!bio$|bio\\.css$|upward/|ASSETS/|LOGO\\.svg$|robots\\.txt$|sitemap\\.xml$|llms\\.txt$).+)",
      "has": [
        {
          "type": "host",
          "value": "upwardacademy.com.br"
        }
      ],
      "destination": "https://lp.upwardacademy.com.br/:path",
      "permanent": false
    },
    {
      "source": "/edf",
      "destination": "/edf/",
      "permanent": false
    },
    {
      "source": "/black",
      "destination": "/black/",
      "permanent": false
    },
    {
      "source": "/black-vendas",
      "destination": "/black-vendas/",
      "permanent": false
    },
    {
      "source": "/proposta-:cliente",
      "destination": "/proposta-:cliente/",
      "permanent": false
    },
    {
      "source": "/portfolio",
      "destination": "/proposta-inkolor/",
      "permanent": false
    },
    {
      "source": "/portfolio/",
      "destination": "/proposta-inkolor/",
      "permanent": false
    },
    {
      "source": "/modelos",
      "destination": "/modelos/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "upwardacademy.com.br"
        }
      ],
      "destination": "/upward/index.html"
    },
    {
      "source": "/curso-ugc-ia",
      "destination": "/curso-ugc-ia/index.html"
    },
    {
      "source": "/wdf",
      "destination": "/index-v1.html"
    },
    {
      "source": "/wdf/(.*)",
      "destination": "/$1"
    },
    {
      "source": "/wdf2",
      "destination": "/wdf2.html"
    },
    {
      "source": "/bio",
      "destination": "/bio.html"
    },
    {
      "source": "/promo",
      "destination": "/index-v2.html"
    },
    {
      "source": "/",
      "destination": "/index-v2.html"
    }
  ],
  "headers": [
    {
      "source": "/ASSETS/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/v2/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.css",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.woff2",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/proposta-:cliente",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/proposta-:cliente/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/proposta-:cliente/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/proposta-:cliente/(index\\.html|proposta\\.js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/proposta-:cliente/(.*)\\.(mp4|webp|jpg)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000"
        }
      ]
    },
    {
      "source": "/modelos",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/modelos/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/modelos/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/modelos/(index\\.html|proposta\\.js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/modelos/(.*)\\.(mp4|webp|jpg)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000"
        }
      ]
    }
  ]
}
